<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash icon. The system scales it to 288 dp; 32.4 dp insets on the 108 dp
     foreground make its 72 dp tile come out at the design's 120 dp. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_launcher_foreground"
    android:inset="32.4dp" />
