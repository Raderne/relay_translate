<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen before Android 12 (design "Launch": accent-900 ground, 120 dp mark centred).
     180 dp foreground = 120 dp tile. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/relay_accent_900" />
    <item
        android:width="180dp"
        android:height="180dp"
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center" />
</layer-list>
